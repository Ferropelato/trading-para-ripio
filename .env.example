# Copiar este archivo a ".env" (sin el ".example") y completar con tus
# credenciales reales. El archivo ".env" NUNCA debe subirse a git -- ya
# está listado en .gitignore para evitar esto por accidente.
#
# Para cargarlo en Python: pip install python-dotenv
#   from dotenv import load_dotenv; load_dotenv()
# (RipioBrokerAdapter ya intenta load_dotenv() al instanciarse.)

# --- Ripio Trade (recomendado) ---
# Crear en: https://trade.ripio.com/market/api/token
# Permisos: Lectura (+ Compra/Venta solo si vas a operar). NUNCA retiro.
RIPIO_API_TOKEN=
RIPIO_API_SECRET=

# --- Alpaca (acciones de EE.UU. -- prueba de concepto, ver README) ---
# Crear cuenta de paper trading gratis en https://alpaca.markets (solo email,
# sin aprobación previa, sin plata real).
ALPACA_API_KEY_ID=
ALPACA_SECRET_KEY=

# --- Bróker genérico / Libertex (esqueleto) ---
BROKER_API_KEY=
BROKER_API_SECRET=

# --- Alertas por Telegram (opcional) ---
# 1. Hablar con @BotFather en Telegram para crear un bot y obtener el token
# 2. Mandarle un mensaje al bot y usar getUpdates para obtener tu chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Alertas por email (opcional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
